# ---- Copy this file to .env and fill in what you have. ----
# Every value below is OPTIONAL. Awaaz Shield runs end-to-end with
# NONE of these set: it falls back to the heuristic risk scorer and
# a local dev-mode login. Add real values when you're ready.

# App / session
APP_SECRET_KEY=dev-secret-change-me
SESSION_COOKIE_NAME=awaaz_session
CORS_ORIGINS=http://localhost:5173

# Set to "true" once you've wired up a real Firebase project and
# dropped a service-account JSON at the path below. Until then the
# backend accepts dev-mode logins (see app/auth.py) and clearly
# labels sessions as non-production.
# Require users to click the emailed verification link before signing in (recommended).
# Set to false ONLY while testing if verification emails are not arriving.
REQUIRE_EMAIL_VERIFIED=true
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Anthropic (Claude) scoring. Leave ANTHROPIC_API_KEY empty to use
# the deterministic heuristic scorer instead — it needs no key at all.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional server-side speech-to-text configuration for a future provider adapter.
# The current microphone prototype uses the browser's speech recognition and does not require a key.
DEEPGRAM_API_KEY=

# Save calls/transcripts/alerts to Firestore (only used when FIREBASE_ENABLED=true and the key file exists).
# Digit runs (OTPs, card/phone numbers) are masked in what gets saved.
FIRESTORE_ENABLED=true
FIRESTORE_LOAD_LIMIT=50
FIRESTORE_MASK_NUMBERS=true

# Speech-to-text defaults for a future server-side provider adapter.
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_MODEL=nova-3
# Words Deepgram listens for harder, comma separated (leave out to use the built-in scam-call list; set empty to turn off).
# DEEPGRAM_KEYTERMS=OTP,KYC,UPI,CVV
# Silence (ms) that closes a phrase. Higher keeps sentences whole but adds a little delay.
# DEEPGRAM_ENDPOINTING_MS=500
# Consent: bump the version to ask everyone to accept again
CONSENT_VERSION=2026-10-v1
CONSENT_LOG_PATH=./data/consents.jsonl

