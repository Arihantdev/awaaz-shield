# Copy to .env.local. All of these are OPTIONAL — the app runs without
# any of them, using the backend's dev-mode login and browser speech
# recognition instead of Firebase/Deepgram.

VITE_API_BASE_URL=http://localhost:8000

# Firebase web app config (Project settings -> General -> Your apps -> SDK
# setup and configuration, in the Firebase console). Leave all blank to
# use backend dev-mode login instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Address of the separate "claim, terms and conditions" website (terms-site/). Default: same host, port 5174.
VITE_TERMS_URL=
